  "secrets": [],
  "tests": [
    {
      "id": "tiers.board",
      "name": "Your tier list opens with items ready to drag into tiers",
      "path": "/",
      "expectSelector": "#board[data-view=\"yours\"] ~ #tray button[data-item]",
      "visual": true,
      "impact": [
        "public/**",
        "api.js"
      ]
    },
    {
      "name": "The board switches to the group's ranking",
      "path": "/",
      "expectSelector": "#view-toggle button[data-view=\"group\"]"
    },
    {
      "name": "Below F, a Want to row takes the ones not got to yet",
      "path": "/",
      "expectSelector": "#board ~ #want[data-drop=\"W\"]"
    },
    {
      "name": "A new item can be added",
      "path": "/",
      "expectSelector": "#add-form input[name=\"name\"]"
    },
    {
      "name": "The page has a line for who else is here",
      "path": "/",
      "expectSelector": "header #presence[aria-live=\"polite\"]"
    }
  ]
}